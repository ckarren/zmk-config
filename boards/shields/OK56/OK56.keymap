#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  BSPC |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |  BSLH |
// |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   '   |  RET  |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   		|  N   |  M    |  ,    |  .   |   /   | SHIFT |
// |       |     |  [  |  ]   | LOWER| SPACE| 		  	| SPACE| UPPER |  ;    | GRAVE|       |       |
            bindings = <
&kp ESC   &kp N1 &kp N2   &kp N3   &kp N4 &kp N5                &kp N6     &kp N7   &kp N8    &kp N9  &kp N0   &kp BSPC
&kp TAB   &kp Q  &kp W    &kp E    &kp R  &kp T                 &kp Y      &kp U    &kp I     &kp O   &kp P    &kp BSLH
&kp LCTRL &kp A  &kp S    &kp D    &kp F  &kp G                 &kp H      &kp J    &kp K     &kp L   &kp SQT  &kp RET
&kp LSHFT &kp Z  &kp X    &kp C    &kp V  &kp B                 &kp N      &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                 &kp LBKT &kp RBKT &mo 1  &kp SPACE             &kp SPACE  &mo 2    &kp SEMI  &kp GRAVE
            >;
        };

        lower_layer {
            display-name = "Lower Layer";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |  -   |   =   |  DEL  |
// | nxtsk |btlder|    |      |      |      |                   |      |       |       |  _   |   +   |       |
// |       |     |     |      |      |  [   |                   |  ]   |       |       |  (   |   )   |   ~   |
// |       |     |     |      |      |  {   |                   |  }   |       |       |  up  | right |       |
//               |     |      |      |      |                   |      |       | left  |  dn  |              
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3 &bt BT_SEL 4 	&trans    &trans    &trans    &kp MINUS   &kp EQUAL &kp DEL
&C_AL_NEXT_TASK &bootloader        &trans        &trans        &trans       &trans       	&trans    &trans    &trans    &kp UNDER   &kp PLUS  &trans
&trans      &trans        &trans        &trans        &trans       &kp LBKT             &kp RBKT  &trans    &trans    &kp LPAR    &kp RPAR  &kp TILDE
&trans      &trans        &trans        &trans        &trans       &kp LBRC             &kp RBRC  &trans    &trans    &kp UP      &kp RIGHT &trans
		          &trans        &trans        &trans       &trans               &trans    &trans    &kp LEFT  &kp DOWN
            >; 
        };

        raise_layer {
            display-name = "Raise Layer";
// ------------------------------------------------------------------------------------------------------------
// |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                  |      |       |       |      |       | DEL   |
// |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |                  |  7   |   8   |   9   |      |       | btlder|
// |       |     |     |      |      |      |                  |  4   |   5   |   6   |      |       |       |
// |       |     |     |      |      |      |                  |  1   |   2   |   3   |      |       |       |
//               |     |      |      | ALT  |                  |      |       |   0   |      |
            bindings = <
&kp F1    &kp F2 &kp F3 &kp F4  &kp F5  &kp F6                       &trans      &trans    &trans    &trans   &trans    &kp DEL
&kp F7    &kp F8 &kp F9 &kp F10 &kp F11 &kp F12                      &kp N7      &kp N8    &kp N9    &trans   &trans    &bootloader
&trans    &trans &trans &trans  &trans  &trans                       &kp N4      &kp N5    &kp N6    &trans   &trans    &trans
&trans    &trans &trans &trans  &trans  &trans                       &kp N1      &kp N2    &kp N3    &trans   &trans    &trans
                 &trans &trans  &trans  &kp LALT                       &trans      &trans    &kp N0    &trans
            >; 
        };
    };
};
